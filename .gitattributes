# Auto-detect text files and normalize line endings
* text=auto

# Archivos de código y plantillas
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Archivos binarios (no modificar finales de línea)
*.jpg binary
*.jpeg binary
*.png binary
*.keras binary
*.joblib binary
*.sqlite3 binary
*.pdf binary
